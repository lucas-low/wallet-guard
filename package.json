{
  "name": "wallet-guard",
  "version": "0.1.0",
  "description": "Pre-signing review for wallet transactions: a deterministic policy floor over decoded calldata, with an optional LLM reviewer. Ships as a CLI and an MCP server.",
  "license": "MIT",
  "author": "Lucas Low",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-low/wallet-guard.git"
  },
  "keywords": [
    "mcp",
    "ethereum",
    "wallet",
    "security",
    "transaction-simulation",
    "ai-agents"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "wallet-guard": "src/cli/index.ts",
    "wallet-guard-mcp": "src/mcp/server.ts"
  },
  "files": [
    "src",
    "data",
    "evals/cases.ts",
    "tests/helpers.ts",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.166",
    "zod": "^4.6.7"
  },
  "scripts": {
    "cli": "bun run src/cli/index.ts",
    "test": "bun test",
    "eval": "bun run evals/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test && bun run eval",
    "mcp": "bun run src/mcp/server.ts"
  }
}
